@Article{s20030672,
AUTHOR = {Chen, Lin and Fu, Jianting and Wu, Yuheng and Li, Haochen and Zheng, Bin},
TITLE = {Hand Gesture Recognition Using Compact CNN via Surface Electromyography Signals},
JOURNAL = {Sensors},
